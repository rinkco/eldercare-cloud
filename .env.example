# 复制为 .env 后按需修改；.env 已被 .gitignore 忽略，不会提交到仓库。

# PostgreSQL
POSTGRES_USER=eldercare
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=eldercare
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# 后端 REST 与 Swagger 的宿主机端口（默认 18080；被占用时可改）
BACKEND_PORT=18080

# 前端 Web 管理台端口（默认 3000；被占用时可改）
FRONTEND_PORT=3000

# 前端容器构建使用的 npm 源（国内可改 https://registry.npmmirror.com）
NPM_REGISTRY=https://registry.npmjs.org

# 前端基础镜像（国内网络可加加速前缀，如 docker.m.daocloud.io/library/）
# NODE_IMAGE=docker.m.daocloud.io/library/node:24-alpine
# NGINX_IMAGE=docker.m.daocloud.io/library/nginx:1.29-alpine

# MQTT（公网部署前必须改为强口令）
MQTT_USER=eldercare
MQTT_PASSWORD=change-me-mqtt

# LoRa 桥接（ChirpStack v4 默认上行 Topic；v3 请改为 application/+/device/+/rx）
# 源 Broker 与平台相同时，USER/PASSWORD 留空即复用上面的 MQTT 账号
LORA_TOPIC=application/+/device/+/event/up
LORA_UID_PREFIX=
LORA_SOURCE_MQTT_HOST=mosquitto
LORA_SOURCE_MQTT_PORT=1883
LORA_SOURCE_MQTT_USER=
LORA_SOURCE_MQTT_PASSWORD=

# JWT 签名密钥：必须自行生成随机值，禁止使用示例或占位值
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# 种子演示账号（docker compose exec backend python -m scripts.seed 时创建/同步）
# 公网演示前务必修改为强口令
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123456
SEED_FAMILY_USERNAME=family
SEED_FAMILY_PASSWORD=family123456

# 登录页「快捷登录」按钮（前端构建时注入，修改后需重建 frontend）
# 口令需与上面的 SEED_* 保持一致，否则快捷登录会提示密码错误；
# 公网演示不想暴露演示账号时，可设为 false 隐藏整块快捷登录
NEXT_PUBLIC_DEMO_LOGIN_ENABLED=true
NEXT_PUBLIC_DEMO_ADMIN_USERNAME=admin
NEXT_PUBLIC_DEMO_ADMIN_PASSWORD=admin123456
NEXT_PUBLIC_DEMO_FAMILY_USERNAME=family
NEXT_PUBLIC_DEMO_FAMILY_PASSWORD=family123456

# Python 依赖源（国内网络慢时可改为 https://pypi.tuna.tsinghua.edu.cn/simple）
PIP_INDEX_URL=https://pypi.org/simple
