# 基础镜像可通过构建参数替换为国内加速前缀
ARG NODE_IMAGE=node:24-alpine
ARG NGINX_IMAGE=nginx:1.29-alpine

# 构建阶段：Node 构建 Next.js 静态导出
FROM ${NODE_IMAGE} AS builder

WORKDIR /app

ARG NPM_REGISTRY=https://registry.npmjs.org
RUN npm config set registry "$NPM_REGISTRY"

# 登录页快捷登录账号（构建期注入，改口令后需重新构建前端）
ARG NEXT_PUBLIC_DEMO_LOGIN_ENABLED=true
ARG NEXT_PUBLIC_DEMO_ADMIN_USERNAME=admin
ARG NEXT_PUBLIC_DEMO_ADMIN_PASSWORD=admin123456
ARG NEXT_PUBLIC_DEMO_FAMILY_USERNAME=family
ARG NEXT_PUBLIC_DEMO_FAMILY_PASSWORD=family123456
ARG NEXT_PUBLIC_DEMO_OWNER_USERNAME=family-owner
ARG NEXT_PUBLIC_DEMO_OWNER_PASSWORD=owner123456
ENV NEXT_PUBLIC_DEMO_LOGIN_ENABLED=$NEXT_PUBLIC_DEMO_LOGIN_ENABLED \
    NEXT_PUBLIC_DEMO_ADMIN_USERNAME=$NEXT_PUBLIC_DEMO_ADMIN_USERNAME \
    NEXT_PUBLIC_DEMO_ADMIN_PASSWORD=$NEXT_PUBLIC_DEMO_ADMIN_PASSWORD \
    NEXT_PUBLIC_DEMO_FAMILY_USERNAME=$NEXT_PUBLIC_DEMO_FAMILY_USERNAME \
    NEXT_PUBLIC_DEMO_FAMILY_PASSWORD=$NEXT_PUBLIC_DEMO_FAMILY_PASSWORD \
    NEXT_PUBLIC_DEMO_OWNER_USERNAME=$NEXT_PUBLIC_DEMO_OWNER_USERNAME \
    NEXT_PUBLIC_DEMO_OWNER_PASSWORD=$NEXT_PUBLIC_DEMO_OWNER_PASSWORD

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY . .
RUN npm run build

# 运行阶段：nginx 托管静态文件并同源反代 API / WebSocket
FROM ${NGINX_IMAGE}

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/out /usr/share/nginx/html

EXPOSE 80
